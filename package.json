{
  "name": "annotations",
  "version": "1.0.12",
  "description": "Highlights and optional notes stored directly in Markdown.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint src manifest.json --max-warnings 0",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write src tests scripts *.mjs *.json",
    "format:check": "prettier --check src tests scripts *.mjs *.json",
    "validate": "npm run check && npm run lint && npm run format:check && npm test && npm run build && node scripts/check-release.mjs",
    "package": "npm run validate && node scripts/package.mjs"
  },
  "author": "Aru Gyani",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/common": "^1.5.5",
    "@playwright/test": "^1.65.0",
    "@types/jsdom": "^30.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "jsdom": "^31.0.1",
    "obsidian": "^1.14.4",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arugyani/annotations.git"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
